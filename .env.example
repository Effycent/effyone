# Copia este archivo como .env.local y completa los valores.
# .env.local NUNCA se sube a Git (ya está en .gitignore).

# --- Supabase: Project Settings > API ---------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROJECT-REF.supabase.co
# Clave pública: "anon" (legacy) o "publishable" (nueva). Cualquiera de las dos sirve.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave secreta: "service_role" (legacy) o "secret" (nueva). SOLO servidor.
SUPABASE_SERVICE_ROLE_KEY=

# --- App --------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Creación del primer Super Admin (se usa una sola vez) ------------------
SUPER_ADMIN_BOOTSTRAP_EMAIL=
SUPER_ADMIN_BOOTSTRAP_NAME=Propietario EffyOne
